{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs", "../scripts/lib/**/*", "../data/schema/**/*"],
  "exclude": ["dist"]
}
