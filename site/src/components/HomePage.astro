---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChoroplethEurope from './charts/ChoroplethEurope.tsx';
import RankedBars from './charts/RankedBars.tsx';
import { chartSources, loadCountries, loadMetadata, loadMinistries } from '../lib/data.ts';
import { localePath, translator, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);

const [countries, metadata, ministries] = await Promise.all([
  loadCountries(),
  loadMetadata(),
  loadMinistries(),
]);

// The citations shown under the chart are the ones actually behind what it draws — the
// instruments that enumerate the counted ministries, and nothing else. The population
// figures used to appear here because the per-million metric divided by them; no chart
// does now, so citing them would be citing a source for a number the chart never shows.
const sources = chartSources(
  ministries.filter((entity) => entity.counts_as_ministry).flatMap((entity) => entity.sources),
);

const isSpanish = locale === 'es';
const countryPathBase = localePath(locale, 'countries');
---

<BaseLayout locale={locale} title={t('site.title')} description={t('site.tagline')}>
  <div class="wide">
    <h1>
      {isSpanish ? 'Cuántos ministerios tiene cada país' : 'How many ministries each country has'}
    </h1>
  </div>

  <div class="wide chart-slot">
    <ChoroplethEurope
      client:load
      locale={locale}
      summaries={countries}
      sources={sources}
      asOf={metadata.as_of}
      methodologyHref={localePath(locale, 'methodology')}
      countryPathBase={countryPathBase}
    />
  </div>

  <div class="wide chart-slot">
    <RankedBars
      client:load
      locale={locale}
      summaries={countries}
      sources={sources}
      asOf={metadata.as_of}
      methodologyHref={localePath(locale, 'methodology')}
      countryPathBase={countryPathBase}
      notes={[
        isSpanish
          ? 'Los ministerios contados y los asientos del gabinete son cifras distintas y no se suman: un jefe de gobierno ocupa asiento sin departamento, y un ministro con dos carteras es un asiento y dos ministerios.'
          : 'Counted ministries and cabinet seats are different figures and are never added together: a head of government holds a seat without a department, and a minister with two portfolios is one seat and two ministries.',
      ]}
    />
  </div>

  <style>
    .chart-slot {
      margin-top: var(--space-6);
    }
  </style>
</BaseLayout>
