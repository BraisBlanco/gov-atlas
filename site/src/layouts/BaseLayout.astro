---
import '../styles/tokens.css';
import {
  assertParity,
  localePath,
  otherLocale,
  translator,
  withBase,
  type Locale,
} from '../i18n/index.ts';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}

const { locale, title, description } = Astro.props;

// A missing translation fails the build rather than shipping a bare key to a reader.
assertParity();

const t = translator(locale);
const other = otherLocale(locale);

// Trailing slashes differ between `astro dev` and the built directory URLs, so compare
// without them. A country page keeps "Países" marked as the section the reader is in.
const trim = (path: string) => path.replace(/\/+$/, '');
const here = trim(Astro.url.pathname);
const sections = [
  { href: localePath(locale), label: t('nav.home'), exact: true },
  { href: localePath(locale, 'countries'), label: t('nav.countries'), exact: false },
  { href: localePath(locale, 'methodology'), label: t('nav.methodology'), exact: false },
  { href: localePath(locale, 'data-quality'), label: t('nav.dataQuality'), exact: false },
].map((section) => {
  const target = trim(section.href);
  return {
    ...section,
    current: section.exact ? here === target : here === target || here.startsWith(`${target}/`),
  };
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === t('site.title') ? title : `${title} — ${t('site.title')}`}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="alternate" hreflang={other} href={localePath(other)} />
    <script is:inline>
      // Stamped before first paint so a reader who chose dark never sees a light flash.
      // Light is the default; the OS preference is not consulted.
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wide site-head-inner">
        <a class="site-brand" href={localePath(locale)}>{t('site.title')}</a>
        <nav class="site-nav" aria-label={t('nav.sections')}>
          {
            sections.map((section) => (
              <a href={section.href} aria-current={section.current ? 'page' : undefined}>
                {section.label}
              </a>
            ))
          }
        </nav>
        <div class="site-controls">
          <a class="site-chip" href={localePath(other)} lang={other} title={t('nav.language')}>
            {other === 'es' ? 'Español' : 'English'}
          </a>
          <button type="button" id="theme-toggle" class="site-chip" aria-label={t('nav.theme')}>
            ◐
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wide">
        <p>
          {t('site.tagline')}. <a href={withBase('data/ministries.json')}>{t('nav.download')}</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>

    <style>
      .site-head {
        border-bottom: 1px solid var(--border);
        background: var(--surface-1);
      }

      .site-head-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        align-items: center;
        padding-block: var(--space-4);
      }

      .site-brand {
        font-family: var(--font-serif);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--text-primary);
        text-decoration: none;
      }

      /* Sections and controls travel together at the right edge; the brand keeps the left.
         On a narrow screen they wrap under it rather than squeezing it. */
      .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        align-items: center;
        margin-inline-start: auto;
        font-family: var(--font-sans);
        font-size: var(--text-sm);
      }

      /* Navigation is not prose: a section name is a place, not a citation, so it carries
         no link colour or underline until the pointer or keyboard is on it. The reader's
         current section is the one that looks solid. */
      .site-nav a {
        color: var(--text-secondary);
        text-decoration: none;
        padding-block: 2px;
        border-bottom: 2px solid transparent;
      }

      .site-nav a:hover,
      .site-nav a:focus-visible {
        color: var(--text-primary);
        border-bottom-color: var(--border);
      }

      .site-nav a[aria-current='page'] {
        color: var(--text-primary);
        font-weight: 600;
        border-bottom-color: var(--text-primary);
      }

      /* The language switch and the theme toggle change how the page is shown rather than
         where the reader is, so they sit apart from the sections and look like controls. */
      .site-controls {
        display: flex;
        gap: var(--space-2);
        align-items: center;
        font-family: var(--font-sans);
        font-size: var(--text-sm);
      }

      .site-chip {
        appearance: none;
        background: none;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        color: var(--text-secondary);
        cursor: pointer;
        font: inherit;
        line-height: 1.4;
        padding: 2px var(--space-2);
        text-decoration: none;
      }

      .site-chip:hover,
      .site-chip:focus-visible {
        color: var(--text-primary);
        border-color: var(--axis);
      }

      main {
        padding-block: var(--space-8);
      }

      .site-foot {
        border-top: 1px solid var(--border);
        padding-block: var(--space-5);
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        color: var(--text-secondary);
      }
    </style>
  </body>
</html>
